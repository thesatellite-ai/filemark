{
  "name": "@filemark/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "rebuild": "electron-rebuild -f -m . -w libsql",
    "predev": "electron-rebuild -f -m . -w libsql",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "ai.thesatellite.filemark.desktop",
    "productName": "Filemark",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/**/*.md"
    ],
    "asarUnpack": [
      "node_modules/@libsql/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "dir"
    },
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@filemark/core": "workspace:*",
    "@filemark/csv": "workspace:*",
    "@filemark/json": "workspace:*",
    "@filemark/mdx": "workspace:*",
    "@filemark/schema": "workspace:*",
    "@libsql/client": "^0.14.0",
    "@uiw/react-codemirror": "^4.25.10",
    "chokidar": "^4.0.1",
    "drizzle-orm": "^0.36.0",
    "flexsearch": "^0.7.43",
    "katex": "^0.17.0",
    "lucide-react": "^0.460.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
