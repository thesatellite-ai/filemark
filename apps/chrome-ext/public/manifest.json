{
  "manifest_version": 3,
  "name": "Filemark",
  "version": "0.1.0",
  "description": "Beautiful in-browser viewer for markdown, JSON, CSV, SQL. Open local files in Chrome — search, organize, no upload.",
  "action": {
    "default_title": "Open Filemark"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "declarativeNetRequest", "scripting"],
  "host_permissions": ["file:///*"],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["src/app/index.html", "assets/*", "content/main.js", "content/assets/*"],
      "matches": ["file:///*", "<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
