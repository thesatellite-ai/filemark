{
  "manifest_version": 3,
  "name": "Filemark: Markdown & Data Viewer",
  "version": "0.1.13",
  "description": "Markdown viewer for Chrome that also renders JSON, CSV, and SQL/Prisma/DBML schemas as interactive views — 100% local, no uploads.",
  "homepage_url": "https://khanakia.com/apps/filemark/",
  "action": {
    "default_title": "Open Filemark"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "curtain.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/app/index.html",
        "assets/*",
        "content/main.js",
        "content/assets/*"
      ],
      "matches": [
        "file:///*",
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
