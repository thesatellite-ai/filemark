# Publishing tokens for `task publish` / `task publish-ovsx`. Copy to `.env`
# (git-ignored) and fill in. Never commit real tokens.

# VS Code Marketplace — Azure DevOps Personal Access Token, scope Marketplace →
# Manage. Create at https://dev.azure.com (User settings → Personal Access
# Tokens). The `khanakia` publisher must already exist at
# https://marketplace.visualstudio.com/manage.
VSCE_PAT=

# Open VSX (for Cursor / VSCodium users) — token from https://open-vsx.org
# (sign in with GitHub → Access Tokens).
OVSX_PAT=
