{
  "name": "@filemark/website-new",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:cf": "vite build && cp -R public/. dist/client/ && rm -rf dist-cf && mkdir -p dist-cf/apps/filemark && cp -R dist/client/. dist-cf/apps/filemark/ && cp dist/client/index.html dist-cf/index.html && cp dist/client/404.html dist-cf/404.html && cp _headers dist-cf/_headers",
    "preview": "vite preview",
    "deploy": "pnpm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@filemark/core": "workspace:*",
    "@filemark/datagrid": "workspace:*",
    "@filemark/mdx": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.105.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}