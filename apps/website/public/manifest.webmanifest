{
  "name": "Filemark",
  "short_name": "Filemark",
  "description": "Free Chrome extension that opens local and remote .md, .json, .csv, .sql, .prisma and .dbml files with real interactive renderers. 100% client-side.",
  "start_url": "/apps/filemark/",
  "scope": "/apps/filemark/",
  "display": "minimal-ui",
  "background_color": "#ffffff",
  "theme_color": "#0a0a0a",
  "icons": [
    {
      "src": "/apps/filemark/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any maskable"
    }
  ]
}
