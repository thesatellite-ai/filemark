# Google Tag Manager container id for the marketing site.
# Public value (it ships in the page HTML). GA4 is configured as a tag
# inside this GTM container. Copy this file to .env to enable analytics on
# local production builds:  cp .env.example .env
# VITE_* vars are baked at build time, so re-run build:cf after changing.
VITE_GTM_ID=GTM-W5RL34X
